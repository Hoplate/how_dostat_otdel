; Godot 4 native desktop project. No WebView, HTML or JavaScript runtime.
config_version=5

[application]
config/name="Как достать отдел — Дима на работе"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/version="0.2.0"

[autoload]
Profile="*res://scripts/profile.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.075, 0.089, 0.105, 1)

[audio]
driver/enable_input=false
